{
  "functions": {
    "api/register.js": {
      "maxDuration": 10
    },
    "api/admin/login.js": {
      "maxDuration": 10
    },
    "api/admin/me.js": {
      "maxDuration": 10
    },
    "api/admin/logout.js": {
      "maxDuration": 10
    },
    "api/admin/data.js": {
      "maxDuration": 10
    },
    "api/admin/gift.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ]
}
